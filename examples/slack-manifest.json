{
  "display_information": {
    "name": "bsbctl Slack"
  },
  "oauth_config": {
    "scopes": {
      "user": ["channels:history", "channels:read", "groups:history", "groups:read", "im:history", "mpim:history"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_uninstalled", "tokens_revoked"],
      "user_events": ["message.channels", "message.groups", "message.im", "message.mpim"]
    },
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
