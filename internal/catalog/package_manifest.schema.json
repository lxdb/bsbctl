{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bsbctl.invalid/schema/package-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "protocol_version",
    "executable",
    "executable_sha256",
    "executable_size",
    "execution_modes",
    "channels",
    "assets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "protocol_version": { "const": "1.0" },
    "executable": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "executable_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "executable_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 134217728
    },
    "execution_modes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["resident", "interactive"]
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "kind": {
            "enum": ["query", "command"]
          }
        }
      }
    },
    "config_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sha256", "size"],
      "properties": {
        "source": { "const": "config.schema.json" },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "sha256", "size", "media_type"],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
            "allOf": [
              {"not": {"pattern": "(^|/)\\.{1,2}(/|$)"}},
              {"not": {"pattern": "//|/$"}}
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 67108864
          },
          "media_type": {
            "enum": ["image/png", "application/x-busy-animation"]
          }
        }
      }
    }
  }
}
