{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "credentials_home": {"type": "string", "minLength": 1},
    "configuration_home": {"type": "string", "minLength": 1},
    "label": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]{0,11}$"},
    "badge": {"type": "string", "pattern": "^[A-Z0-9]$"},
    "poll_interval_seconds": {"type": "integer", "minimum": 60, "maximum": 900},
    "warning_remaining_percent": {"type": "integer", "minimum": 1, "maximum": 100},
    "critical_remaining_percent": {"type": "integer", "minimum": 0, "maximum": 99}
  },
  "additionalProperties": false
}
